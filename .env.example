# Local callback origin. Set the deployed HTTPS origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project settings (public client values only).
# Never put a service-role/secret key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only keys. Do not use NEXT_PUBLIC_ for either value.
# Required for Paystack transactions and payment record verification.
SUPABASE_SERVICE_ROLE_KEY=
PAYSTACK_SECRET_KEY=
